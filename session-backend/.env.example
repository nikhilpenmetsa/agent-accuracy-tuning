# Session Backend Stack Configuration
# Copy this file to .env and customize as needed

STACK_NAME=${PROJECT_NAME}-session-backend-stack

# AgentCore Memory Configuration
# Run 1-setup-memory.sh to create the memory resource
# The script will automatically update this value
AGENTCORE_MEMORY_ID=your-memory-id-here

# DynamoDB Configuration
SESSIONS_TABLE_NAME=${STACK_NAME}-sessions
