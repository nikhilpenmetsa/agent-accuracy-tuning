# Knowledge Base Stack Configuration
# Stack-specific settings (sources ../config.env for global settings)

# Stack Naming (uses PROJECT_NAME from config.env)
STACK_NAME=${PROJECT_NAME}-kb-stack

# Embedding Model
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Knowledge Base Configuration
KB_NAME=${PROJECT_NAME}-knowledge-base
KB_DESCRIPTION="Knowledge Base for HR documents"

# Data Source Configuration
DATA_SOURCE_NAME=hr-docs-s3-source

# Paths (relative to kb directory)
HR_DOCS_DIR=../hr-docs
TEMPLATE_FILE=cloudformation-template.yaml
